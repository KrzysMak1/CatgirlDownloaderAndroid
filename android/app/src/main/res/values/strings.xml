    <string name="danbooru_tags_title">Search tags</string>
    <string name="danbooru_tags_help">Separate tags with spaces and write multi-word tags with underscores (cat_ears, not \"cat ears\"). Put a minus before a tag to exclude it (-cat_ears). Without a Danbooru account you can use at most two tags.</string>
